// Cloudflare Worker that serves the static site in public/.
// Workers Builds settings: Root directory "portfolio", Deploy command "npx wrangler deploy".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "how-tf-can-ai-have-taste",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
